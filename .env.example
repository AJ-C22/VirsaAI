# Copy to .env (backend / project root) — never commit secrets
VIRSA_JWT_SECRET=replace-with-long-random-string
GEMINI_KEY=
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=visra
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword

# App URL used for Stripe success/cancel redirects
APP_URL=http://127.0.0.1:3000

# Stripe Checkout (Dashboard → Products → recurring prices)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_FAMILY=price_...
STRIPE_PRICE_LEGACY=price_...

