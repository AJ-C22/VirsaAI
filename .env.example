# Copy to .env (backend / project root) — never commit secrets
VIRSA_JWT_SECRET=replace-with-long-random-string
GEMINI_KEY=
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=visra
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword

# App URL used for Stripe success/cancel redirects
APP_URL=http://127.0.0.1:3000

# Comma-separated browser origins allowed to call the API (do not use *)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Stripe Checkout (Dashboard → Products → recurring prices)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_FAMILY=price_...
STRIPE_PRICE_LEGACY=price_...

# Invite mail. Leave blank to log letters in backend/logs/mail.log.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Virsa <noreply@virsa.ai>
# Or Resend instead of SMTP:
# RESEND_API_KEY=
# ALERT_WEBHOOK_URL=
# RATE_LIMIT_AUTH=10
# RATE_LIMIT_INVITE=20
# RATE_LIMIT_UPLOAD=10

# Later (Supabase)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
